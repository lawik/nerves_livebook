# How Mobius remembers: the CircularBuffer

## Watch the ring

A ring of fixed slots. **Green** = newest insert; the head wraps around, overwriting the oldest. **Insert** / **Reset**.

```elixir
ring_capacity = 8

ring_insert = Kino.Control.button("Insert")
ring_reset = Kino.Control.button("Reset")

ring_slots = fn count ->
  newest_slot = if count > 0, do: rem(count - 1, ring_capacity), else: nil

  for slot <- 0..(ring_capacity - 1) do
    value = Enum.find(count..1//-1, fn v -> rem(v - 1, ring_capacity) == slot end)

    state =
      cond do
        slot == newest_slot -> "newest"
        value != nil -> "filled"
        true -> "empty"
      end

    %{"slot" => slot, "label" => (value && to_string(value)) || "·", "state" => state, "w" => 1}
  end
end

arcs =
  VegaLite.new()
  |> VegaLite.mark(:arc, inner_radius: 70, stroke: "white", stroke_width: 2, tooltip: true)
  |> VegaLite.encode_field(:color, "state",
    type: :nominal,
    scale: [domain: ["newest", "filled", "empty"], range: ["#22c55e", "#9ca3af", "#e5e7eb"]],
    legend: nil
  )

labels =
  VegaLite.new()
  |> VegaLite.mark(:text, radius: 105, fill: "black")
  |> VegaLite.encode_field(:text, "label", type: :nominal)

# Push into a shared dataset with window: capacity for in-place, flicker-free updates.
ring_chart =
  VegaLite.new(width: 320, height: 320, title: "A ring of #{ring_capacity} slots")
  |> VegaLite.data(name: "ring")
  |> VegaLite.encode_field(:theta, "w", type: :quantitative, stack: true)
  |> VegaLite.encode_field(:order, "slot", type: :quantitative)
  |> VegaLite.layers([arcs, labels])
  |> Kino.VegaLite.new()

update_ring = fn count ->
  Kino.VegaLite.push_many(ring_chart, ring_slots.(count), dataset: "ring", window: ring_capacity)
end

update_ring.(0)

Kino.listen(
  Kino.Control.tagged_stream(insert: ring_insert, reset: ring_reset),
  0,
  fn
    {:insert, _event}, count ->
      count = count + 1
      update_ring.(count)
      {:cont, count}

    {:reset, _event}, _count ->
      update_ring.(0)
      {:cont, 0}
  end
)

Kino.Layout.grid([Kino.Layout.grid([ring_insert, ring_reset], columns: 2), ring_chart], boxed: true)
```

## How it stays fast: two lists

O(1) inserts via an [Okasaki queue](https://en.wikipedia.org/wiki/Okasaki%27s_queue) — two lists:

* `a` — input stack, newest-first
* `b` — output queue, older items in order
* `to_list = b ++ Enum.reverse(a)`

Insert just conses onto `a`. When `a` must flip, it reverses into `b` once and drops the oldest — amortized O(1).

```elixir
Map.from_struct(Enum.into(1..5, CircularBuffer.new(3)))
```

### See the two lists change

New values cons onto `a` (green = newest). `b` stays empty until the first eviction, then `a` reverses into `b`.

```elixir
tl_capacity = 4
tl_insert = Kino.Control.button("Insert")
tl_reset = Kino.Control.button("Reset")

# Real buffer's a/b lists → fixed 2-row grid (invisible empties keep the push count
# constant for flicker-free window replace).
tl_cells = fn buffer ->
  %{a: a, b: b} = Map.from_struct(buffer)
  lists = [{"a · input stack", a, :a}, {"b · output queue", b, :b}]

  for {row, list, which} <- lists, pos <- 0..(tl_capacity - 1) do
    value = Enum.at(list, pos)

    kind =
      cond do
        value == nil -> "empty"
        which == :a and pos == 0 -> "newest"
        which == :a -> "recent"
        true -> "old"
      end

    %{"row" => row, "pos" => pos, "label" => (value && to_string(value)) || "", "kind" => kind}
  end
end

tl_rects =
  VegaLite.new()
  |> VegaLite.mark(:rect, corner_radius: 4, stroke: "white", stroke_width: 3)
  |> VegaLite.encode_field(:color, "kind",
    type: :nominal,
    scale: [domain: ["newest", "recent", "old", "empty"], range: ["#22c55e", "#60a5fa", "#9ca3af", "#ffffff"]],
    legend: nil
  )

tl_text =
  VegaLite.new()
  |> VegaLite.mark(:text, fill: "white", font_size: 15, font_weight: "bold")
  |> VegaLite.encode_field(:text, "label", type: :nominal)

tl_chart =
  VegaLite.new(width: 300, height: 130)
  |> VegaLite.data(name: "cells")
  |> VegaLite.encode_field(:x, "pos", type: :ordinal, axis: nil)
  |> VegaLite.encode_field(:y, "row", type: :nominal, axis: [title: nil])
  |> VegaLite.layers([tl_rects, tl_text])
  |> Kino.VegaLite.new()

tl_update = fn buffer ->
  Kino.VegaLite.push_many(tl_chart, tl_cells.(buffer), dataset: "cells", window: 2 * tl_capacity)
end

tl_update.(CircularBuffer.new(tl_capacity))

Kino.listen(
  Kino.Control.tagged_stream(insert: tl_insert, reset: tl_reset),
  {CircularBuffer.new(tl_capacity), 0},
  fn
    {:insert, _event}, {buffer, n} ->
      n = n + 1
      buffer = CircularBuffer.insert(buffer, n)
      tl_update.(buffer)
      {:cont, {buffer, n}}

    {:reset, _event}, _state ->
      buffer = CircularBuffer.new(tl_capacity)
      tl_update.(buffer)
      {:cont, {buffer, 0}}
  end
)

Kino.Layout.grid([Kino.Layout.grid([tl_insert, tl_reset], columns: 2), tl_chart], boxed: true)
```

## Introduction

A fixed-size FIFO: once full, every insert drops the oldest. Constant memory, whatever the uptime. Ships with Nerves Livebook (Mobius depends on it).

## Creating and filling a buffer

Create with a max size — immutable, inserts return a new buffer.

```elixir
cb = CircularBuffer.new(3)
```

```elixir
cb = Enum.reduce(1..3, cb, fn n, cb -> CircularBuffer.insert(cb, n) end)
```

## Overflow is the whole point

Full at 3. A fourth pushes the oldest (`1`) off the front.

```elixir
cb = CircularBuffer.insert(cb, 4)
```

Step by step: `count` caps at 3, `oldest` advances.

```elixir
steps =
  1..7
  |> Enum.scan(CircularBuffer.new(3), fn n, cb -> CircularBuffer.insert(cb, n) end)
  |> Enum.zip(1..7)
  |> Enum.map(fn {cb, inserted} ->
    %{
      inserted: inserted,
      contents: inspect(CircularBuffer.to_list(cb)),
      oldest: CircularBuffer.oldest(cb),
      newest: CircularBuffer.newest(cb),
      count: Enum.count(cb)
    }
  end)

Kino.DataTable.new(steps)
```

## Reading a buffer

```elixir
buffer = Enum.into(1..10, CircularBuffer.new(5))

%{
  to_list: CircularBuffer.to_list(buffer),
  oldest: CircularBuffer.oldest(buffer),
  newest: CircularBuffer.newest(buffer),
  empty?: CircularBuffer.empty?(buffer)
}
```

Implements `Collectable` + `Enumerable` — the full `Enum` toolbox, always over the last N items.

```elixir
{Enum.count(buffer), Enum.sum(buffer), Enum.max(buffer)}
```

## Why Mobius uses it

* **Event log** — recent events, bounded.
* **Metric history** — each RRD resolution is a `CircularBuffer` (next notebook).
